---
/**
 * about-01 — image + bloc de texte + liste à puces + bouton
 *
 * Le bloc « qui sommes-nous » d'une page d'accueil, ou le corps d'une page
 * À propos. Deux colonnes en desktop, empilé en dessous de 992px.
 */

export interface Props {
	eyebrow?: string;
	title?: string;
	/** Paragraphes du corps. Un élément = un <p>. */
	paragraphs?: string[];
	bullets?: string[];
	cta?: { label: string; href: string } | null;
	imgSrc?: string;
	imgAlt?: string;
	imgWidth?: number;
	imgHeight?: number;
	imgSide?: "left" | "right";
	tone?: "default" | "alt";
	/** Encart chiffré posé sur l'image (années, chantiers…). Laisse vide si non fourni. */
	badge?: { value: string; label: string } | null;
	headingLevel?: "h2" | "h3";
	/** aria-label et texte affiché quand aucune image n'est fournie. */
	emptyImgLabel?: string;
	emptyImgText?: string;
}

const {
	eyebrow = "WHO WE ARE",
	title = "A sentence that makes people want to trust us with the job",
	paragraphs = [
		"PLACEHOLDER — first paragraph: where the business comes from, what it does, for whom. Written in the first person plural, no jargon.",
		"PLACEHOLDER — second paragraph: the way of working, what concretely sets it apart, the area covered.",
	],
	bullets = ["PLACEHOLDER — commitment 1", "PLACEHOLDER — commitment 2", "PLACEHOLDER — commitment 3", "PLACEHOLDER — commitment 4"],
	cta = { label: "Contact us", href: "/contact/" },
	imgSrc,
	imgAlt = "",
	imgWidth = 1100,
	imgHeight = 1300,
	imgSide = "left",
	tone = "default",
	badge = null,
	headingLevel = "h2",
	emptyImgLabel = "PLACEHOLDER — photo to be provided by the client",
	emptyImgText = "CLIENT PHOTO",
} = Astro.props;

const Heading = headingLevel;
---

<section class={`abt01 abt01--${tone} abt01--img-${imgSide}`}>
	<div class="abt01__inner">
		<div class="abt01__media">
			{
				imgSrc ? (
					<img class="abt01__img" src={imgSrc} alt={imgAlt} width={imgWidth} height={imgHeight} loading="lazy" decoding="async" />
				) : (
					<div class="abt01__img abt01__img--empty" role="img" aria-label={emptyImgLabel}>
						<span>{emptyImgText}</span>
					</div>
				)
			}
			{
				badge && (
					<p class="abt01__badge">
						<span class="abt01__badge-value">{badge.value}</span>
						<span class="abt01__badge-label">{badge.label}</span>
					</p>
				)
			}
		</div>

		<div class="abt01__text">
			{
				eyebrow && (
					<p class="ctc01__eyebrow">
						<span class="ctc01__eyebrow-dot" aria-hidden="true" />
						{eyebrow}
					</p>
				)
			}
			<Heading class="abt01__title">{title}</Heading>

			{paragraphs.map((p) => <p class="abt01__p">{p}</p>)}

			{
				bullets?.length > 0 && (
					<ul class="abt01__list">
						{bullets.map((b) => (
							<li class="abt01__li">
								{/* Coche EN PASTILLE, relevee sur la reference : un disque plein
								    de la couleur d'accent, coche BLANCHE pleine a l'interieur. Un
								    simple trait de coche se perd a cote d'un texte de 16px ; la
								    pastille est ce qui fait la liste. */}
								<span class="abt01__check" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="12" height="12" focusable="false">
										<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="currentColor" />
									</svg>
								</span>
								<span>{b}</span>
							</li>
						))}
					</ul>
				)
			}

			{
				cta && (
					<a class="abt01__btn" href={cta.href}>
						{cta.label}
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.abt01,
	.abt01 *,
	.abt01 *::before,
	.abt01 *::after {
		box-sizing: border-box;
	}

	.abt01 {
		font-family: var(--brand-font-body);
		background: var(--color-bg);
		color: var(--color-text);
		padding-block: var(--space-section);
	}

	.abt01--alt {
		background: var(--color-bg-alt);
	}

	.abt01__inner {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		align-items: center;
		gap: clamp(var(--space-10), 6vw, var(--space-20));
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.abt01--img-right .abt01__media {
		order: 2;
	}

	.abt01--img-right .abt01__text {
		order: 1;
	}

	/* ------------------------------------------------------------------ image */

	.abt01__media {
		position: relative;
	}

	.abt01__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 6;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.abt01__img--empty {
		display: grid;
		place-items: center;
		background: var(--color-bg-sunken);
		border: 1px dashed var(--color-border-strong);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-eyebrow);
		color: var(--color-text-muted);
	}

	/* L'encart déborde du coin de l'image : c'est le seul geste de composition
	   du bloc, il ne se répète pas ailleurs. */
	.abt01__badge {
		position: absolute;
		right: calc(var(--space-8) * -1);
		bottom: var(--space-8);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-5) var(--space-6);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-lg);
	}

	.abt01__badge-value {
		font-family: var(--brand-font-display);
		font-size: var(--text-xl);
		font-weight: var(--weight-display);
		line-height: 1;
		letter-spacing: var(--tracking-heading);
	}

	.abt01__badge-label {
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
	}

	/* ------------------------------------------------------------------ texte */

	.abt01__title {
		margin: 0 0 var(--space-6);
		font-family: var(--brand-font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-heading);
		text-wrap: balance;
	}

	.abt01__p {
		max-width: var(--measure);
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
		line-height: var(--leading-body);
		color: var(--color-text-muted);
	}

	.abt01__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3) var(--space-6);
		margin: var(--space-8) 0 0;
		padding: 0;
		list-style: none;
	}

	.abt01__li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		font-size: var(--text-base);
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.abt01__check {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		margin-top: 0.05em;
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-radius: var(--radius-pill);
	}

	/* Sur fond peint, le disque d'accent disparait : on inverse. */
	.on-dark .abt01__check {
		color: var(--color-accent);
		background: var(--color-on-accent);
	}

	.abt01__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--tap-target);
		margin-top: var(--space-10);
		padding: var(--space-4) var(--space-8);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		line-height: 1;
		color: var(--color-on-action);
		text-decoration: none;
		background: var(--color-action);
		border-radius: var(--radius-sm);
		transition:
			background-color var(--dur-fast) var(--ease),
			transform var(--dur-fast) var(--ease),
			box-shadow var(--dur-fast) var(--ease);
		/* L'aplat ambre ne fait que 2,08:1 contre le creme : c'est cette
		   bordure qui delimite le bouton sur fond clair (7,03:1). Sur fond
		   sombre le scope .on-dark la ramene a l'ambre, l'aplat suffit. */
		border: 1.5px solid var(--color-action-border);
	
	}

	.abt01__btn:hover {
		background: var(--color-action-hover);
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}

	.abt01__btn:active {
		background: var(--color-action-active);
		box-shadow: none;
		transform: translateY(0);
	}

	.abt01 :focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}

	@media (max-width: 61.999rem) {
		.abt01__inner {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-10);
		}

		.abt01--img-right .abt01__media,
		.abt01--img-right .abt01__text {
			order: initial;
		}

		.abt01__img {
			aspect-ratio: 16 / 10;
		}

		/* L'encart ne déborde plus : hors grille, il sortirait de l'écran. */
		.abt01__badge {
			right: var(--space-5);
			bottom: var(--space-5);
		}
	}

	@media (max-width: 39.999rem) {
		.abt01__list {
			grid-template-columns: minmax(0, 1fr);
		}

		.abt01__btn {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.abt01__btn {
			transition-duration: 0.01ms !important;
		}
	}
</style>
