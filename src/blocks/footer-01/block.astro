---
/**
 * footer-01 — pied de page multi-colonnes
 *
 * Marque + colonnes de liens + contact + barre légale.
 * Un <nav> par colonne, chacun avec son propre aria-label : sinon un lecteur
 * d'écran annonce quatre fois « navigation » sans savoir laquelle.
 */

export interface FooterLink {
	label: string;
	href: string;
}

export interface FooterColumn {
	title: string;
	links: FooterLink[];
}

export interface Props {
	brandName?: string;
	/** Une ou deux phrases sur l'entreprise. */
	brandText?: string;
	logoSrc?: string;
	logoAlt?: string;
	logoWidth?: number;
	logoHeight?: number;
	columns?: FooterColumn[];
	contact?: { label: string; value: string; href?: string }[];
	socials?: { label: string; href: string; icon?: "facebook" | "instagram" | "linkedin" }[];
	legalLinks?: FooterLink[];
	/** Année de départ du copyright. L'année courante est calculée. */
	since?: number;
	/** Ligne discrète en bas. Laisse vide si le client ne veut pas de signature. */
	credit?: string | null;
	/** Remplace toute la ligne "© {année} {marque}. Tous droits réservés." par un texte exact, une seule ligne. */
	legalLine?: string | null;
	/**
	 * Variante balisée de `legalLine`, injectée telle quelle. Sert quand la
	 * ligne doit porter deux couleurs — la référence met une moitié de sa
	 * mention légale dans sa couleur d'accent. Prioritaire sur `legalLine`.
	 */
	legalHtml?: string | null;
	/**
	 * Fond du pied de page. `ink` peint à l'encre et bascule le contenu dans le
	 * jeu inversé ; `light` le laisse sur le fond de page, texte à l'encre.
	 */
	tone?: "ink" | "light";
	/** aria-label de la nav des liens légaux. */
	legalNavLabel?: string;
}

const {
	brandName = "CLIENT NAME",
	brandText = "PLACEHOLDER — a sentence about the business, what it does, and the area it serves.",
	logoSrc,
	logoAlt = "",
	logoWidth = 160,
	logoHeight = 32,
	columns = [
		{
			title: "Services",
			links: [
				{ label: "Service one", href: "/prestations/une/" },
				{ label: "Service two", href: "/prestations/deux/" },
				{ label: "Service three", href: "/prestations/trois/" },
			],
		},
		{
			title: "The company",
			links: [
				{ label: "About", href: "/a-propos/" },
				{ label: "Projects", href: "/realisations/" },
				{ label: "Contact", href: "/contact/" },
			],
		},
	],
	contact = [
		{ label: "Phone", value: "PLACEHOLDER — PHONE NUMBER" },
		{ label: "Email", value: "PLACEHOLDER — EMAIL" },
		{ label: "Address", value: "PLACEHOLDER — ADDRESS" },
	],
	socials = [],
	legalLinks = [
		{ label: "Legal notice", href: "/mentions-legales/" },
		{ label: "Privacy policy", href: "/confidentialite/" },
	],
	since,
	credit = null,
	legalLine = null,
	legalHtml = null,
	tone = "ink",
	legalNavLabel = "Legal links",
} = Astro.props;

const year = new Date().getFullYear();
const copyright = since && since < year ? `${since}–${year}` : `${year}`;

const socialPaths: Record<string, string> = {
	facebook: "M13.5 8.5h2.2l.3-2.6h-2.5V4.7c0-.75.2-1.26 1.28-1.26H16V1.1A17 17 0 0014 1c-2 0-3.3 1.2-3.3 3.4v1.5H8.5v2.6h2.2V16h2.8V8.5z",
	instagram: "M8.5 1.5h-1c-2 0-2.6.02-3.3.2a3.6 3.6 0 00-2.5 2.5c-.18.7-.2 1.3-.2 3.3v1c0 2 .02 2.6.2 3.3a3.6 3.6 0 002.5 2.5c.7.18 1.3.2 3.3.2h1c2 0 2.6-.02 3.3-.2a3.6 3.6 0 002.5-2.5c.18-.7.2-1.3.2-3.3v-1c0-2-.02-2.6-.2-3.3a3.6 3.6 0 00-2.5-2.5c-.7-.18-1.3-.2-3.3-.2zM8 5a3 3 0 110 6 3 3 0 010-6zm3.6-.9a.7.7 0 110 1.4.7.7 0 010-1.4z",
	linkedin: "M2 5.8h2.6V15H2V5.8zM3.3 1.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM6.5 5.8H9v1.3c.35-.65 1.2-1.4 2.6-1.4 2.1 0 3 1.3 3 3.6V15h-2.6V9.9c0-1.2-.4-1.9-1.4-1.9-1 0-1.5.65-1.5 1.9V15H6.5V5.8z",
};
---

<footer class={`ftr01 ftr01--${tone}${tone === "ink" ? " on-dark" : ""}`}>
	<div class="ftr01__inner">
		<div class="ftr01__top">
			<div class="ftr01__brand">
				{
					logoSrc ? (
						<img class="ftr01__logo" src={logoSrc} alt={logoAlt} width={logoWidth} height={logoHeight} loading="lazy" decoding="async" />
					) : (
						<p class="ftr01__brand-name">{brandName}</p>
					)
				}
				{brandText && <p class="ftr01__brand-text">{brandText}</p>}

				{
					socials.length > 0 && (
						<ul class="ftr01__socials">
							{socials.map((s) => (
								<li>
									<a class="ftr01__social" href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
										<svg viewBox="0 0 17 17" width="17" height="17" aria-hidden="true" focusable="false">
											<path d={socialPaths[s.icon ?? "facebook"] ?? socialPaths.facebook} fill="currentColor" />
										</svg>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>

			{
				columns.map((col) => (
					<nav class="ftr01__col" aria-label={col.title}>
						<h2 class="ftr01__col-title">{col.title}</h2>
						<ul class="ftr01__list">
							{col.links.map((l) => (
								<li>
									<a class="ftr01__link" href={l.href}>
										<span class="ftr01__link-label">{l.label}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}

			{
				contact.length > 0 && (
					<div class="ftr01__col">
						<h2 class="ftr01__col-title">Contact</h2>
						<ul class="ftr01__list ftr01__list--contact">
							{contact.map((c) => (
								<li class="ftr01__contact">
									<span class="ftr01__contact-label">{c.label}</span>
									{c.href ? (
										<a class="ftr01__link" href={c.href}>
											<span class="ftr01__link-label">{c.value}</span>
										</a>
									) : (
										<span class="ftr01__contact-value">{c.value}</span>
									)}
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>

		<div class="ftr01__bottom">
			{
				legalHtml ? (
					<p class="ftr01__copy" set:html={legalHtml} />
				) : (
					<p class="ftr01__copy">{legalLine ?? `© ${copyright} ${brandName}. All rights reserved.`}</p>
				)
			}

			{
				legalLinks.length > 0 && (
					<nav class="ftr01__legal" aria-label={legalNavLabel}>
						<ul class="ftr01__legal-list">
							{legalLinks.map((l) => (
								<li>
									<a class="ftr01__link ftr01__link--small" href={l.href}>
										<span class="ftr01__link-label">{l.label}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}

			{credit && <p class="ftr01__credit">{credit}</p>}
		</div>
	</div>
</footer>

<style>
	.ftr01,
	.ftr01 *,
	.ftr01 *::before,
	.ftr01 *::after {
		box-sizing: border-box;
	}

	.ftr01 {
		font-family: var(--brand-font-body);
		color: var(--color-text);
		padding-block: var(--space-section) var(--space-8);
	}

	.ftr01--ink {
		background: var(--brand-ink);
	}

	/* Ton clair : le pied reste sur le fond de page. Pas de `on-dark`, donc
	   tous les jetons de couleur gardent leur valeur normale. */
	.ftr01--light {
		background: var(--color-bg);
	}

	.ftr01__inner {
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	/* ------------------------------------------------------------------- haut */

	.ftr01__top {
		display: grid;
		grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
		gap: var(--space-10);
		padding-bottom: var(--space-12);
	}

	.ftr01__brand {
		max-width: 26rem;
	}

	.ftr01__logo {
		display: block;
		height: auto;
		max-width: 100%;
		margin-bottom: var(--space-5);
	}

	.ftr01__brand-name {
		margin: 0 0 var(--space-4);
		font-family: var(--brand-font-display);
		font-size: var(--text-lg);
		font-weight: var(--weight-display);
		letter-spacing: var(--tracking-heading);
		line-height: var(--leading-heading);
	}

	.ftr01__brand-text {
		margin: 0;
		font-size: var(--text-sm);
		line-height: var(--leading-body);
		color: var(--color-text-muted);
	}

	.ftr01__socials {
		display: flex;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.ftr01__social {
		display: grid;
		place-items: center;
		width: var(--tap-target);
		height: var(--tap-target);
		color: var(--color-text-muted);
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		transition:
			color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease),
			transform var(--dur-fast) var(--ease);
	}

	.ftr01__social:hover {
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	/* --------------------------------------------------------------- colonnes */

	.ftr01__col-title {
		margin: 0 0 var(--space-5);
		font-family: var(--brand-font-body);
		font-size: var(--text-2xs);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}

	.ftr01__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ftr01__link {
		display: inline-block;
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease);
	}

	/* Même idiome que la nav principale : le trait se déploie depuis la gauche. */
	.ftr01__link-label {
		position: relative;
		display: inline-block;
	}

	.ftr01__link-label::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.25em;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur) var(--ease);
	}

	.ftr01__link:hover {
		color: var(--color-text);
	}

	.ftr01__link:hover .ftr01__link-label::after {
		transform: scaleX(1);
	}

	.ftr01__list--contact {
		gap: var(--space-4);
	}

	.ftr01__contact {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.ftr01__contact-label {
		font-size: var(--text-2xs);
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}

	.ftr01__contact-value {
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-muted);
		overflow-wrap: anywhere;
	}

	/* ------------------------------------------------------------------- bas */

	.ftr01__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4) var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	.ftr01__copy,
	.ftr01__credit {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-text-subtle);
	}

	.ftr01__legal-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ftr01__link--small {
		font-size: var(--text-xs);
	}

	.ftr01 :focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}

	@media (max-width: 61.999rem) {
		.ftr01__top {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-10);
		}

		.ftr01__brand {
			grid-column: 1 / -1;
			max-width: none;
		}
	}

	@media (max-width: 39.999rem) {
		.ftr01__top {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-8);
		}

		.ftr01__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ftr01__link-label::after,
		.ftr01__social {
			transition-duration: 0.01ms !important;
		}
	}
</style>
