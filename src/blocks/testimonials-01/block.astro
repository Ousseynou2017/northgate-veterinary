---
/**
 * testimonials-01 — grille d'avis : citation + nom + rôle + photo
 *
 * GRILLE, pas carrousel. Un carrousel cache 2 avis sur 3, demande du JS, se
 * navigue mal au clavier, et sur un site de 3 à 6 témoignages il n'apporte
 * rien. Si le client en a vingt, on en choisit six.
 *
 * ATTENTION : un témoignage inventé engage la responsabilité du client. Les
 * valeurs par défaut sont des PLACEHOLDER et doivent être remplacées par des
 * avis réels, avec accord de publication.
 */

export interface Testimonial {
	quote: string;
	name: string;
	role?: string;
	/** Ville ou date : ce qui rend l'avis vérifiable. */
	meta?: string;
	photoSrc?: string;
	photoAlt?: string;
	/** Note sur 5. Omettre s'il n'y a pas de note réelle. */
	rating?: number;
}

export interface Props {
	eyebrow?: string;
	title?: string;
	intro?: string;
	testimonials?: Testimonial[];
	columns?: 2 | 3;
	tone?: "default" | "alt";
	headingLevel?: "h2" | "h3";
}

const {
	eyebrow = "CUSTOMER REVIEWS",
	title = "What they say",
	intro,
	testimonials = [
		{ quote: "PLACEHOLDER — REAL TESTIMONIAL TO COLLECT. Do not publish until the client has provided the review and the person's consent.", name: "PLACEHOLDER — NAME", role: "PLACEHOLDER — ROLE", meta: "PLACEHOLDER — CITY" },
		{ quote: "PLACEHOLDER — REAL TESTIMONIAL TO COLLECT. Do not publish until the client has provided the review and the person's consent.", name: "PLACEHOLDER — NAME", role: "PLACEHOLDER — ROLE", meta: "PLACEHOLDER — CITY" },
		{ quote: "PLACEHOLDER — REAL TESTIMONIAL TO COLLECT. Do not publish until the client has provided the review and the person's consent.", name: "PLACEHOLDER — NAME", role: "PLACEHOLDER — ROLE", meta: "PLACEHOLDER — CITY" },
	],
	columns = 3,
	tone = "alt",
	headingLevel = "h2",
} = Astro.props;

const Heading = headingLevel;
const initials = (n: string) =>
	n
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0])
		.join("")
		.toUpperCase();
---

<section class={`tst01 tst01--${tone}`}>
	<div class="tst01__inner">
		<header class="tst01__head tst01__head--center">
			{
				eyebrow && (
					<p class="ctc01__eyebrow">
						<span class="ctc01__eyebrow-dot" aria-hidden="true" />
						{eyebrow}
					</p>
				)
			}
			{title && <Heading class="tst01__title">{title}</Heading>}
			{intro && <p class="tst01__intro">{intro}</p>}
		</header>

		<ul class="tst01__grid" style={`--tst-cols:${columns}`}>
			{
				testimonials.map((t) => (
					<li class="tst01__item">
						<figure class="tst01__card">
							<svg class="tst01__mark" viewBox="0 0 32 24" width="32" height="24" aria-hidden="true" focusable="false">
								<path
									d="M13 24V13.2C13 5.9 17.2 1.2 24.6 0l1.4 3.6c-4.3 1.1-6.6 3.6-6.9 7.4H24V24H13zm-13 0V13.2C0 5.9 4.2 1.2 11.6 0L13 3.6C8.7 4.7 6.4 7.2 6.1 11H11V24H0z"
									fill="currentColor"
								/>
							</svg>

							{typeof t.rating === "number" && (
								<p class="tst01__rating" aria-label={`Note : ${t.rating} sur 5`}>
									{[1, 2, 3, 4, 5].map((i) => (
										<svg class={`tst01__star ${i <= Math.round(t.rating ?? 0) ? "is-on" : ""}`} viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
											<path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6L8 1.6z" fill="currentColor" />
										</svg>
									))}
								</p>
							)}

							<blockquote class="tst01__quote">
								<p>{t.quote}</p>
							</blockquote>

							<figcaption class="tst01__author">
								{t.photoSrc ? (
									<img class="tst01__photo" src={t.photoSrc} alt={t.photoAlt ?? ""} width="48" height="48" loading="lazy" decoding="async" />
								) : (
									<span class="tst01__photo tst01__photo--initials" aria-hidden="true">
										{initials(t.name)}
									</span>
								)}
								<span class="tst01__identity">
									<span class="tst01__name">{t.name}</span>
									{(t.role || t.meta) && (
										<span class="tst01__role">
											{[t.role, t.meta].filter(Boolean).join(" · ")}
										</span>
									)}
								</span>
							</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.tst01,
	.tst01 *,
	.tst01 *::before,
	.tst01 *::after {
		box-sizing: border-box;
	}

	.tst01 {
		font-family: var(--brand-font-body);
		background: var(--color-bg);
		color: var(--color-text);
		padding-block: var(--space-section);
	}

	.tst01--alt {
		background: var(--color-bg-alt);
	}

	.tst01__inner {
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.tst01__head {
		max-width: var(--measure);
		margin-bottom: var(--space-12);
	}

	.tst01__head--center {
		max-width: var(--measure-heading);
		margin-inline: auto;
		text-align: center;
	}

	.tst01__head--center .ctc01__eyebrow {
		justify-content: center;
	}

	.tst01__title {
		margin: 0;
		font-family: var(--brand-font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-heading);
		text-wrap: balance;
	}

	.tst01__intro {
		margin: var(--space-5) 0 0;
		font-size: var(--text-md);
		line-height: var(--leading-snug);
		color: var(--color-text-muted);
	}

	/* ------------------------------------------------------------------ grille */

	.tst01__grid {
		display: grid;
		grid-template-columns: repeat(var(--tst-cols, 3), minmax(0, 1fr));
		gap: var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tst01__item {
		display: flex;
	}

	/* PEAU §6 : rayon 22px, padding 28/20, fond crème, AUCUNE bordure. */
	.tst01__card {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 0;
		padding: var(--space-6) var(--space-5);
		background: var(--color-bg-alt);
		border: 0;
		border-radius: var(--radius-md);
		transition:
			background-color var(--dur) var(--ease),
			box-shadow var(--dur) var(--ease);
	}

	/* Section déjà crème : la carte reprend le blanc, sinon elle disparaît. */
	.tst01--alt .tst01__card {
		background: var(--color-bg);
	}

	.tst01__card:hover {
		box-shadow: var(--shadow-md);
	}

	.tst01__mark {
		color: var(--color-accent-line);
		margin-bottom: var(--space-5);
	}

	.tst01__rating {
		display: flex;
		gap: 2px;
		margin: 0 0 var(--space-4);
	}

	.tst01__star {
		color: var(--color-border-strong);
	}

	.tst01__star.is-on {
		color: var(--color-accent);
	}

	.tst01__quote {
		flex: 1;
		margin: 0 0 var(--space-6);
	}

	.tst01__quote p {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-body);
		color: var(--color-text);
	}

	/* ------------------------------------------------------------------ auteur */

	.tst01__author {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.tst01__photo {
		flex-shrink: 0;
		width: var(--space-12);
		height: var(--space-12);
		object-fit: cover;
		border-radius: var(--radius-pill);
	}

	.tst01__photo--initials {
		display: grid;
		place-items: center;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-accent);
		background: var(--color-accent-soft);
	}

	.tst01__identity {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.tst01__name {
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-snug);
	}


	/* Aucun élément interactif par défaut, mais un client peut poser un lien
	   dans le contenu : la règle doit exister avant, pas après. */
	.tst01 :focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}

	.tst01__role {
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-subtle);
	}

	@media (max-width: 61.999rem) {
		.tst01__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.tst01__item:last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 39.999rem) {
		.tst01__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.tst01__item:last-child:nth-child(odd) {
			grid-column: auto;
		}

		.tst01__card {
			padding: var(--space-6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tst01__card {
			transition-duration: 0.01ms !important;
		}
	}
</style>
