---
/**
 * services-grid-cta-01 — LOCAL au projet, composition relevée sur la référence.
 *
 * Pourquoi ce bloc existe, et pourquoi il remplace DEUX sections :
 * sur la référence, la section « Services » et l'encart « Réservez votre
 * rendez-vous » ne sont pas deux sections empilées — c'est UNE grille de
 * 3 × 2 cases de 370 × 360 (gouttière 20), dont les cinq premières sont les
 * prestations et dont la SIXIÈME est la carte d'appel à l'action. Relevé à
 * 1440 px : cases à x = 137 / 527 / 917, rangées à y = 4436 / 4816, cartes
 * crème `rgb(255,252,250)` rayon 24, pastille ronde d'accent 48 px avec une
 * icône blanche de 28, puis titre, puis description. La carte d'appel à
 * l'action est rayon 22, peinte à l'accent, avec une photo posée dans son
 * coin bas-droit.
 *
 * Le projet avait ces deux objets en deux sections successives
 * (services-detail-01 + cta-01) : c'est ce que ce bloc corrige.
 *
 * Il reste LOCAL : c'est une composition de la référence, elle n'a rien à
 * faire dans blocs-astro/.
 */
export interface Entry {
	title: string;
	text: string;
	icon?: string;
}

export interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	entries: Entry[];
	/** La sixième case. Passe `null` pour n'avoir que les prestations. */
	cta?: {
		title: string;
		text: string;
		label: string;
		href: string;
		imgSrc?: string;
		imgAlt?: string;
		imgWidth?: number;
		imgHeight?: number;
	} | null;
}

const { id, eyebrow, title, entries = [], cta = null } = Astro.props;

// L'ÉTOILE posée derrière le chien, comme sur la référence : un astre à dix
// branches, calculé ici plutôt que recopié à la main — un chemin SVG écrit en
// dur ne se relit pas et ne se règle pas.
const BRANCHES = 10, R_EXT = 100, R_INT = 58;
const etoile = Array.from({ length: BRANCHES * 2 }, (_, i) => {
	const r = i % 2 === 0 ? R_EXT : R_INT;
	const a = (i * Math.PI) / BRANCHES - Math.PI / 2;
	return `${(100 + r * Math.cos(a)).toFixed(1)},${(100 + r * Math.sin(a)).toFixed(1)}`;
}).join(" ");

// Même jeu de tracés que services-01 : une seule définition du vocabulaire
// d'icônes sur la page, sinon deux sections dessinent la même patte
// différemment.
const paths: Record<string, string> = {
	patte: "M7.5 9.5a1.6 2.1 0 100-4.2 1.6 2.1 0 000 4.2zM12 8.3a1.7 2.2 0 100-4.4 1.7 2.2 0 000 4.4zM16.5 9.5a1.6 2.1 0 100-4.2 1.6 2.1 0 000 4.2zM12 11c3 0 5 2.3 5 4.4 0 1.8-1.5 3-3.4 3-.9 0-1.3-.4-1.6-.4s-.7.4-1.6.4c-1.9 0-3.4-1.2-3.4-3C7 13.3 9 11 12 11z",
	tonte: "M6 4.5l6 7.5M18 4.5l-6 7.5M12 12v7.5M8 6.5a2 2 0 11-3-2.6 2 2 0 013 2.6zM16 6.5a2 2 0 103-2.6 2 2 0 00-3 2.6z",
	dent: "M8.5 3.5C6 3.5 4.5 5.4 4.5 8c0 3.3 1 5.4 1.7 8.4.4 1.7.8 3.1 1.9 3.1s1.2-1.6 1.6-3.4c.3-1.3.6-2.1 2.3-2.1s2 .8 2.3 2.1c.4 1.8.5 3.4 1.6 3.4s1.5-1.4 1.9-3.1c.7-3 1.7-5.1 1.7-8.4 0-2.6-1.5-4.5-4-4.5-1.7 0-2.6.8-3.5.8s-1.8-.8-3.5-.8z",
	coeur: "M12 20s-7-4.5-7-9.2A3.8 3.8 0 0112 8a3.8 3.8 0 017 2.8C19 15.5 12 20 12 20z",
	cloche: "M18 15.5V11a6 6 0 10-12 0v4.5L4.5 18h15L18 15.5zM10 20.5a2 2 0 004 0",
	bol: "M4 11h16c0 4.4-3.6 8-8 8s-8-3.6-8-8zM7.5 8.2c.6-1.4 2.3-2.2 4.5-2.2s3.9.8 4.5 2.2",
};
---

<section class="sgc01" id={id}>
	<div class="sgc01__inner">
		<header class="sgc01__head">
			{
				eyebrow && (
					<p class="ctc01__eyebrow">
						<span class="ctc01__eyebrow-dot" aria-hidden="true" />
						{eyebrow}
					</p>
				)
			}
			<h2 class="sgc01__title">{title}</h2>
		</header>

		<div class="sgc01__grid">
			{
				entries.map((e) => (
					<article class="sgc01__card">
						<span class="sgc01__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="28" height="28" focusable="false">
								<path
									d={paths[e.icon ?? "patte"] ?? paths.patte}
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						<h3 class="sgc01__card-title">{e.title}</h3>
						<p class="sgc01__text">{e.text}</p>
					</article>
				))
			}

			{
				cta && (
					<article class="sgc01__cta-card on-dark">
						<div class="sgc01__cta-text">
							<h3 class="sgc01__cta-title">{cta.title}</h3>
							<p class="sgc01__cta-p">{cta.text}</p>
						</div>
						<a class="sgc01__cta-btn" href={cta.href}>
							{cta.label}
						</a>
						{/* L'étoile est SOUS la photo dans le DOM : pas de z-index à
						    gérer, l'ordre suffit. Purement décorative. */}
						<svg class="sgc01__cta-star" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
							<polygon points={etoile} />
						</svg>
						{cta.imgSrc && (
							<img
								class="sgc01__cta-img"
								src={cta.imgSrc}
								alt={cta.imgAlt ?? ""}
								width={cta.imgWidth ?? 220}
								height={cta.imgHeight ?? 280}
								loading="lazy"
								decoding="async"
							/>
						)}
					</article>
				)
			}
		</div>
	</div>
</section>

<style>
	.sgc01,
	.sgc01 *,
	.sgc01 *::before,
	.sgc01 *::after {
		box-sizing: border-box;
	}

	.sgc01 {
		padding-block: var(--space-16);
		background: var(--color-bg);
	}

	.sgc01__inner {
		max-width: var(--container);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	/* Titre centré, 620 px de mesure : relevé de la référence, comme les
	   autres titres de section sauf celui du contact. */
	.sgc01__head {
		max-width: 620px;
		margin-inline: auto;
		margin-bottom: var(--space-12);
		text-align: center;
	}

	.sgc01__head .ctc01__eyebrow {
		justify-content: center;
	}

	.sgc01__title {
		margin: 0;
		font-family: var(--brand-font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-display);
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-heading);
		text-wrap: balance;
	}

	/* 3 colonnes, gouttière 20 : 3 × 370 + 2 × 20 = 1150, la largeur utile. */
	.sgc01__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.sgc01__card {
		display: flex;
		flex-direction: column;
		min-height: 360px;
		padding: 30px 24px;
		background: var(--color-bg-alt);
		border-radius: 24px;
	}

	/* Pastille ronde d'accent, icône blanche : c'est elle qui donne le rythme
	   de la grille. Sans fond, les six cases se lisent comme du texte. */
	.sgc01__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		margin-bottom: auto;
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-radius: var(--radius-pill);
	}

	.sgc01__card-title {
		margin: var(--space-8) 0 var(--space-3);
		font-family: var(--brand-font-display);
		font-size: var(--text-lg);
		font-weight: var(--weight-display);
		line-height: var(--leading-heading);
	}

	.sgc01__text {
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-body);
		color: var(--color-text-muted);
	}

	/* ------------------------------------------------------------------
	   LA SIXIÈME CASE — l'appel à l'action.
	   Sur la référence elle est orange ; ici elle est VERTE (FORMAT.md,
	   tableau des couleurs). Le bouton, lui, reste ambre : c'est la couleur
	   d'action principale, et elle doit se détacher de l'aplat vert.
	   ------------------------------------------------------------------ */
	.sgc01__cta-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 360px;
		padding: 30px 24px;
		overflow: hidden;
		/* --brand-accent, pas --color-accent : la carte porte `on-dark`, et
		   dans ce scope --color-accent est ECLAIRCI pour rester lisible sur
		   l'encre. Mesuré : la carte sortait deux tons plus claire que
		   l'en-tete. On veut le vert de marque, le vrai. */
		color: var(--brand-surface);
		background: var(--brand-accent);
		border-radius: 22px;
	}

	.sgc01__cta-title {
		margin: 0 0 var(--space-3);
		font-family: var(--brand-font-display);
		font-size: var(--text-xl);
		font-weight: var(--weight-display);
		line-height: var(--leading-heading);
	}

	.sgc01__cta-p {
		/* La photo occupe le coin bas-droit : le texte s'arrête avant elle,
		   sinon il passe dessous et devient illisible. */
		max-width: 15ch;
		margin: 0;
		font-size: var(--text-base);
		line-height: var(--leading-body);
		opacity: 0.92;
	}

	.sgc01__cta-btn {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		min-height: var(--tap-target);
		margin-top: var(--space-8);
		padding: var(--space-3) var(--space-6);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		line-height: 1;
		color: var(--color-on-action);
		text-decoration: none;
		background: var(--color-action);
		border: 1.5px solid var(--color-action-border);
		border-radius: var(--radius-pill);
		transition:
			background-color var(--dur-fast) var(--ease),
			transform var(--dur-fast) var(--ease);
	}

	.sgc01__cta-btn:hover {
		background: var(--color-action-hover);
		transform: translateY(-1px);
	}

	/* Le chien est DÉTOURÉ (PNG à fond transparent) et posé debout sur le
	   bord bas de la carte, comme sur la référence. Pas de cadre, pas de
	   rayon : une photo rectangulaire à cet endroit fait un autocollant,
	   c'est ce qu'il y avait avant.
	   Il ne réserve pas de place dans le flux : la hauteur de la carte est
	   fixée par min-height, donc il ne peut pas bouger la mise en page —
	   CLS inchangé. */
	/* On cale la HAUTEUR, pas la largeur : le chien est debout sur le bord
	   bas, c'est sa hauteur qui doit tenir dans la carte de 360. Une largeur
	   fixe le faisait dépasser et `overflow: hidden` lui coupait les pattes. */
	/* Un vert à peine plus clair que la carte : l'étoile doit se deviner, pas
	   se lire. Sur la référence c'est le même geste, en orange. */
	.sgc01__cta-star {
		position: absolute;
		right: -28px;
		bottom: -34px;
		width: 270px;
		height: 270px;
		fill: color-mix(in oklab, var(--brand-surface) 13%, var(--brand-accent));
		pointer-events: none;
	}

	.sgc01__cta-img {
		position: absolute;
		right: 0;
		bottom: 0;
		width: auto;
		height: 262px;
		pointer-events: none;
	}

	@media (max-width: 61.999rem) {
		.sgc01__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 39.999rem) {
		.sgc01__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.sgc01__card,
		.sgc01__cta-card {
			min-height: 0;
		}

		/* Sous 640, la carte d'action n'a plus la largeur d'accueillir le
		   chien à côté du texte : il rétrécit. */
		.sgc01__cta-img {
			height: 215px;
		}

		.sgc01__cta-star {
			width: 200px;
			height: 200px;
			right: -20px;
			bottom: -26px;
		}

		.sgc01__cta-p {
			max-width: 24ch;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sgc01__cta-btn {
			transition: none;
		}

		.sgc01__cta-btn:hover {
			transform: none;
		}
	}
</style>
