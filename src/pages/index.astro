---
import "../styles/_tokens.css";

import Navbar01 from "../blocks/navbar-01/block.astro";
import Hero01 from "../blocks/hero-01/block.astro";
import Keywords01 from "../blocks/keywords-01/block.astro";
import Stats01 from "../blocks/stats-01/block.astro";
import Services01 from "../blocks/services-01/block.astro";
import About01 from "../blocks/about-01/block.astro";
import Process01 from "../blocks/process-01/block.astro";
import Faq01 from "../blocks/faq-01/block.astro";
import Contact01 from "../blocks/contact-01/block.astro";
import Footer01 from "../blocks/footer-01/block.astro";

// Bloc LOCAL au projet (composition relevée sur la référence, cf. LAYOUT.md §2
// section 8). Il ne vient pas de la bibliothèque et n'y retournera pas.
import ServicesGridCta01 from "../local/services-grid-cta-01/block.astro";
import AboutSplit01 from "../local/about-split-01/block.astro";
import GalleryRibbon01 from "../local/gallery-ribbon-01/block.astro";
import ReviewsCarousel01 from "../local/reviews-carousel-01/block.astro";
import NoticePill01 from "../local/notice-pill-01/block.astro";

// Les animations d'apparition. Un seul composant, posé une fois : il pose
// lui-même l'état caché PAR LE SCRIPT et ne cache rien si le JS ne tourne pas.
import Reveal from "../local/reveal.astro";

// ---------------------------------------------------------------------------
// IMAGES — photographies sous licence Pexels, licence lue sur la page source de
// chaque fichier. Source, auteur, licence et date de vérification : une ligne
// par fichier dans reference/IMAGES.md.
//
// Les fichiers servis sont en WebP, recadrés au rapport de forme du §2 de
// LAYOUT.md et produits à 1,5× la taille de mise en page (le hero à 1×, il est
// déjà en 1920). Les `width`/`height` déclarés ci-dessous restent les
// dimensions de MISE EN PAGE : ce sont elles qui réservent la place et tiennent
// le CLS à 0.
//
// Les trois cadres carrés des sections (services, appel à l'action, FAQ) sont
// des PHOTOS depuis le 20/09 au soir, plus des illustrations au trait : une
// par thème de section — soins, urgences, questions.
//
// La colonne du milieu du « à propos » porte une VIDÉO muette en boucle, sous
// la même licence Pexels. Son garde-fou est dans le bloc : preload="none",
// lecture à l'entrée dans la fenêtre, arrêtée en mouvement réduit.
//
// Aucun être vivant généré : les 19 photographies et la vidéo sont des prises
// de vue réelles.
// ---------------------------------------------------------------------------
const IMG = "/img";

// ---------------------------------------------------------------------------
// COORDONNÉES — 22/09. Ce ne sont pas de vraies coordonnées et ce ne sont pas
// non plus des coordonnées inventées au hasard : chaque valeur vient d'une
// plage RÉSERVÉE à la fiction, pour qu'aucun appel ni aucun courriel ne parte
// chez un tiers si quelqu'un clique.
//   · `555-01xx` est la plage nord-américaine réservée aux œuvres de fiction ;
//   · `.example.com` est réservé par la RFC 2606, il ne sera jamais attribué ;
//   · l'adresse est celle d'un cabinet qui n'existe pas.
// Elles remplacent les « PLACEHOLDER » : un bandeau de marqueurs sous un pied
// de page se lit comme un site inachevé, là où une coordonnée réservée se lit
// comme une maquette assumée. Le `noindex` et les deux mentions « concept
// piece » restent ce qui dit que le cabinet n'existe pas.
// ---------------------------------------------------------------------------
// L'URL PUBLIQUE réelle. `canonical` et `og:url` doivent désigner la page
// telle qu'elle est servie, sinon le canonical envoie les robots sur un
// domaine qui n'existe pas et l'aperçu de partage pointe dans le vide.
// L'adresse e-mail, elle, reste sur `.example.com` : c'est une coordonnée
// fictive, pas une URL de page.
const SITE = "https://northgate-veterinary.vercel.app/";
const TEL = "(555) 010-0142";
const TEL_HREF = "tel:+15550100142";
const MAIL = "hello@northgate.example.com";
const ADRESSE = "1420 Alder Street, Portland, OR";
const HORAIRES = "Mon–Fri 8:00–18:00 · Sat 9:00–13:00 · Sun closed";
const galerieAlts = [
	"A puppy held in gloved hands during a check-up",
	"A cat looking out through the door of its carrier",
	"A puppy being washed during a grooming visit",
	"Sterilised instruments laid out on a tray",
	"A vet listening to a cat's chest with a stethoscope",
	"A rabbit, photographed close up",
	"A cat asleep on a soft blanket",
	"An owner holding her dog in the consulting room",
];
const galerie = Array.from({ length: 8 }, (_, i) => ({
	label: galerieAlts[i],
	text: `PHOTO ${i + 1}`,
	src: `${IMG}/galerie-${i + 1}.webp`,
	alt: galerieAlts[i],
}));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Northgate Veterinary — a calm place for your animal to be cared for</title>

		<!-- SEO — 22/09. Description, canonical et Open Graph posés pour que le
		     lien se présente correctement quand il est partagé.

		     LE `noindex` RESTE, et ce n'est pas un oubli : ce site est une
		     MAQUETTE. Le cabinet n'existe pas, les six avis et les quatre
		     chiffres sont écrits pour la démonstration, et les coordonnées sont
		     des valeurs réservées. Indexer ça, c'est présenter une clinique
		     vétérinaire imaginaire à quelqu'un qui cherche un vétérinaire.
		     Il ne se retire qu'avec le reste : vraies coordonnées, vrais avis.

		     PAS de JSON-LD LocalBusiness pour la même raison : ce balisage sert
		     à déclarer un établissement réel, avec son adresse et ses horaires.
		     En poser un ici reviendrait à affirmer que le cabinet existe. -->
		<meta name="robots" content="noindex, nofollow" />
		<meta
			name="description"
			content="Northgate Veterinary is a concept piece: a small-practice veterinary site with unhurried consultations, grooming, dentistry, surgery and a vet on call around the clock."
		/>
		<link rel="canonical" href={SITE} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Northgate Veterinary" />
		<meta property="og:title" content="Northgate Veterinary — a calm place where your animal is known" />
		<meta
			property="og:description"
			content="Concept piece. A small veterinary practice: unhurried visits, the same vet every time, and a price agreed before anything starts."
		/>
		<meta property="og:url" content={SITE} />
		<!-- URL ABSOLUE obligatoire : les aperçus de partage ne résolvent pas un
		     chemin relatif. Dimensions déclarées pour éviter le recadrage. -->
		<meta property="og:image" content={`${SITE}img/hero.webp`} />
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1200" />
		<meta property="og:image:alt" content="A brown and white dog resting, looking straight at the camera" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Préchargement de la police de TITRE uniquement. Obligatoire (§3 du
		     plan) : sans lui, CLS 0,309 / Performance 74 ; avec, CLS 0 / 96.
		     Ne jamais précharger aussi la police de texte : ça annule le gain. -->
		<link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<!-- 0 · LE BANDEAU « CONCEPT PIECE » A QUITTÉ LE HAUT DE PAGE — 20/09.
		     Il tuait l'accueil : la première chose lue était un avertissement.
		     Il ne disparaît pas, il DESCEND, et il est maintenant posé aux deux
		     seuls endroits où il a un travail à faire :
		       1. le sur-titre de la section des avis — les six avis sont écrits
		          pour la maquette ;
		       2. la ligne légale du pied de page — elle couvre aussi les quatre
		          faits chiffrés de stat01.
		     Ces deux lignes ne se retirent pas : sans elles, la page présente
		     des témoignages et des chiffres inventés comme s'ils étaient vrais. -->

		<!-- 1 · Navigation -->
		<Navbar01
			tone="accent"
			{/* LE LOGO CHOISI PAR OUSSEYNOU : celui d'en bas à droite de la
			    planche `logo-site-veterinaire.png` — la patte à la croix.
			    Il est découpé et rendu transparent par
			    scripts/fabrique-logo.mjs : sur la planche il est posé sur un
			    vert plus foncé que l'en-tête, servi tel quel on verrait un
			    rectangle. 640 × 151 natif, servi à 187 × 44. */}
			logoSrc={`${IMG}/logo.png`}
			logoAlt="Northgate Veterinary"
			logoWidth={187}
			logoHeight={44}
			logoHref="/"
			navLabel="Main navigation"
			skipLabel="Skip to main content"
			menuOpenLabel="Open menu"
			menuCloseLabel="Close menu"
			links={[
				{ label: "About", href: "#about" },
				{ label: "Services", href: "#services" },
				{ label: "How it works", href: "#how-it-works" },
				{ label: "Reviews", href: "#reviews" },
				{ label: "FAQ", href: "#faq" },
			]}
			cta={{ label: "Book a visit", href: "#book" }}
		/>

		<main id="main-content">
			<!-- 2 · Hero -->
			<Hero01
				eyebrow="Northgate Veterinary Practice"
				title="A calm place where your animal is known"
				subtitle="Unhurried care from a team your animal gets to know, day and night."
				cta={{ label: "Book a visit", href: "#book" }}
				ctaSecondary={{ label: "Our services", href: "#services" }}
				imgSrc={`${IMG}/hero.webp`}
				imgAlt="A brown and white dog resting, looking straight at the camera"
				imgWidth={1920}
				imgHeight={1200}
			/>

			<!-- 3 · Ruban de mots-clés -->
			<!-- FOND VERT — FORMAT.md §2. La référence le pose sur blanc ; c'est
			     l'un des trois endroits où on différencie par la couleur, décision
			     d'Ousseynou. Mots en blanc (7,65:1 sur ce vert), étoiles en vert
			     d'eau pastel (4,50:1). --color-accent-loud y tombe à 2,88 : il est
			     calibré pour l'encre, pas pour l'accent plein. -->
			<Keywords01
				title="What we treat"
				tone="accent"
				speed={36}
				separator="✲"
				keywords={[
					{ label: "Wellness" },
					{ label: "Grooming" },
					{ label: "Vaccination" },
					{ label: "Dentistry" },
					{ label: "Surgery" },
					{ label: "Emergencies" },
				]}
			/>

			<!-- 4 · Intro — LAYOUT.md §2 section 3 : texte à gauche, IMAGE À DROITE,
			     rapport 496/450. C'est la première image après le hero, et le
			     premier temps de l'alternance gauche/droite. Réutilise about-01,
			     aucun bloc neuf : la composition est la même, seul le côté change.
			     Cadre VIDE à cette étape — aucune photo n'est posée. -->
			<div class="lyt-media-110">
				<About01
					eyebrow="Introduction"
					title="A practice built around the animal"
					paragraphs={["We keep the practice small so every visit has the time it actually needs."]}
					bullets={[]}
					cta={{ label: "Book a visit", href: "#book" }}
					imgSide="right"
					imgSrc={`${IMG}/intro.webp`}
					imgAlt="A vet checking a cat's ear on the consulting table"
					imgWidth={496}
					imgHeight={450}
				/>
			</div>

			<!-- 5 · Faits de fonctionnement — aucun chiffre de performance inventé,
			     seulement des faits vrais par construction (registre stats-01
			     l'interdit sans chiffres vérifiables ; ce sont des faits, pas des
			     performances). -->
			<Stats01
				tone="alt"
				stats={[
					{ value: "7 days", label: "Open every day of the week" },
					{ value: "24/7", label: "A vet on call for emergencies" },
					{ value: "Same week", label: "Most appointments, booked online" },
					{ value: "1 vet", label: "The same one follows your animal" },
				]}
			/>

			<!-- 6 · Pourquoi nous choisir — LAYOUT.md §2 section 5 : IMAGE À GAUCHE,
			     trois arguments à droite. C'est le premier renversement de
			     l'alternance : la section 4 avait son image à droite.
			     about-01 à nouveau, côté inversé par la prop imgSide. -->
			<div class="lyt-media-110">
				<About01
					eyebrow="Why us"
					title="Why owners keep coming back to Northgate"
					paragraphs={[]}
					bullets={[
						"Appointments booked long, never stacked",
						"The same vet, every single visit",
						"A price agreed before anything starts",
					]}
					cta={{ label: "Book a visit", href: "#book" }}
					imgSide="left"
					tone="alt"
					imgSrc={`${IMG}/pourquoi-nous.webp`}
					imgAlt="A golden retriever looking at the camera, head tilted"
					imgWidth={496}
					imgHeight={450}
				/>
			</div>

			<!-- 7 · Services — services-01 n'a pas de champ image (icône seulement,
			     voir rapport final : conflit avec §5 du plan qui prévoit une photo
			     par prestation). -->
			<div id="services">
				<!-- Grille 3 × 2 NUE — FORMAT.md §6 : ni carte, ni fond, ni carte
				     peinte à l'accent. Icône en haut, titre court, description
				     dessous, le tout centré. Icônes du jeu ANIMAL, pas du jeu BTP. -->
				<Services01
					eyebrow="What we do"
					title="Everything your animal needs, under one roof"
					columns={3}
					variant="bare"
					featuredIndex={0}
					services={[
						{ title: "Health checks", text: "Yearly examinations and the vaccines your animal actually needs, nothing more.", icon: "coeur" },
						{ title: "Grooming", text: "Bath, clipping, nails and ears, booked as its own unhurried visit.", icon: "tonte" },
						{ title: "Dental care", text: "Scaling and polishing, catching problems while they are still small.", icon: "dent" },
						{ title: "Surgery", text: "Planned procedures with monitoring until your animal is ready to leave.", icon: "patte" },
						{ title: "Nutrition", text: "A diet built around your animal's age, weight and daily condition.", icon: "bol" },
						{ title: "Emergencies", text: "A vet on call day and night, equipped to act immediately.", icon: "cloche" },
					]}
				/>
			</div>

			<!-- 8 · À propos — LAYOUT.md §2 section 7 : DEUX cadres 365 × 355,
			     rayon 24, un à chaque bord du contenu, texte centré entre les
			     deux, sur fond crème. about-01 ne sait poser qu'une image d'un
			     seul côté : c'est une recomposition, donc un bloc LOCAL.
			     Le placeholder d'image qui était ici est retiré : à cette étape
			     on pose des cadres vides, pas des images. -->
			<div id="about">
				<AboutSplit01
					eyebrow="About the practice"
					title="We look after your animal like our own"
					paragraphs={["A small practice by choice, and it stays that way."]}
					bullets={[]}
					cta={null}
					tone="alt"
					frameWidth={365}
					frameHeight={355}
					frameRadius={24}
					videoSrc={`${IMG}/a-propos-video.mp4`}
					videoPoster={`${IMG}/a-propos-video-poster.webp`}
					videoWidth={365}
					videoHeight={465}
					videoLabel="A calm dog resting indoors — silent looping clip"
					leftSrc={`${IMG}/a-propos-gauche.webp`}
					leftAlt="A rabbit held carefully in two hands"
					rightSrc={`${IMG}/a-propos-droite.webp`}
					rightAlt="An owner sitting with her dog on her lap"
				/>
			</div>

			<!-- 9 · Services + appel à l'action — UNE SEULE SECTION depuis le
			     21/09. Le projet en avait deux : services-detail-01, puis
			     cta-01 juste en dessous. Relevé à 1440 sur la référence :
			     c'est une grille de 3 × 2 cases de 370 × 360, gouttière 20,
			     dont la SIXIÈME EST la carte « Réservez votre rendez-vous ».
			     Les cinq premières sont les prestations : pastille ronde
			     d'accent avec l'icône, titre, description.
			     D'où services-grid-cta-01, local au projet.
			     La carte est orange sur la référence ; ici elle est VERTE, et
			     son bouton reste ambre — l'action principale doit se détacher
			     de l'aplat, sinon plus rien ne se distingue. -->
			<ServicesGridCta01
				eyebrow="Services"
				title="What actually happens during each visit"
				entries={[
					{ icon: "tonte", title: "Grooming & boarding", text: "Bath, clipping, nails and ears, booked on its own. Boarding keeps the same routine." },
					{ icon: "coeur", title: "Consultations & prevention", text: "A full examination, the vaccines your animal needs, and a plan for the year ahead." },
					{ icon: "dent", title: "Dental care", text: "Scaling and polishing under anaesthetic, every tooth checked while problems are still small." },
					{ icon: "patte", title: "Surgery & hospitalisation", text: "Planned procedures with monitoring until your animal wakes. You are called the moment they do." },
					{ icon: "cloche", title: "Emergencies 24/7", text: "A vet on call day and night, equipped to act rather than send you elsewhere." },
				]}
				cta={{
					title: "Book your visit today",
					text: "Plan a visit with our team and keep your animal in good shape.",
					label: "Book a visit",
					href: "#book",
					/* PNG DÉTOURÉ, fond transparent : sur la référence le chien est
					   posé debout sur le bord bas de l'encart, il n'est pas dans
					   un cadre. Une photo rectangulaire à cet endroit fait un
					   autocollant — c'est ce qu'il y avait avant. */
					imgSrc: `${IMG}/cta-chien.png`,
					imgAlt: "",
					imgWidth: 400,
					imgHeight: 773,
				}}
			/>

			<!-- 11 · Comment ça marche -->
			<div id="how-it-works">
				<Process01
					eyebrow="How it works"
					title="Three steps, and your animal is booked in"
					tone="alt"
					media={{ width: 570, height: 398, radius: 38, label: "", text: "", src: `${IMG}/comment-ca-marche.webp`, alt: "A smiling owner laughing beside her husky on a bright sofa" }}
					steps={[
						{ number: "01", title: "Book the slot", text: "Pick a time that fits your week, online or by phone." },
						{ number: "02", title: "Come and visit", text: "A full examination, explained as we go, with time for questions." },
						{ number: "03", title: "Leave with clarity", text: "You know what comes next, and exactly what it will cost." },
					]}
				/>
			</div>

			<!-- 12 · Avis — LAYOUT.md §2 section 11 : CARROUSEL, 3 cartes de 371
			     visibles, gouttière 19, six avis au total. Bloc LOCAL : la grille
			     de testimonials-01 reste en bibliothèque, elle sert encore pour
			     la citation de clôture.
			     Avis inventés, autorisés uniquement parce que le bandeau
			     "concept piece" en tête de page rend la nature fictive explicite.
			     Photos remplacées par des initiales. -->
			<ReviewsCarousel01
				id="reviews"
				eyebrow="Illustrative reviews — concept piece"
				title="What owners say after their first visit"
				cardWidth={371}
				gap={19}
				prevLabel="Previous reviews"
				nextLabel="Next reviews"
				regionLabel="Reviews — scrollable with the arrow keys"
				reviews={[
					{ quote: "They never rush. My cat is anxious at the vet and they take the time she needs, every single visit.", name: "Sarah M.", role: "Cat owner", rating: 5 },
					{ quote: "Called at eleven at night about my dog. Someone picked up, and we were seen within the hour.", name: "James O.", role: "Dog owner", rating: 5 },
					{ quote: "The cost was explained before anything started. No surprise on the invoice, which is rare.", name: "Priya K.", role: "Two dogs", rating: 5 },
					{ quote: "Same vet every time. She knows my rabbit's whole history without ever opening the file.", name: "Tom B.", role: "Rabbit owner", rating: 5 },
					{ quote: "They called the next morning to ask how she had slept. Nobody had ever done that for us.", name: "Hélène D.", role: "Senior dog", rating: 5 },
					{ quote: "We came in for a second opinion and left with a plan we understood. No pressure, no upsell.", name: "Marcus L.", role: "Cat owner", rating: 5 },
				]}
			/>

			<!-- 13 · Galerie — LAYOUT.md §2 section 12 : RUBAN DÉFILANT, pas une
			     grille. 8 vignettes uniques de 325 × 350, rayon 32, série doublée
			     pour boucler (16 au rendu), première vignette à x=10 donc hors
			     gouttière, découpe par overflow-x: clip comme keywords-01.
			     Bloc LOCAL : gallery-01 (grille + visionneuse) reste en
			     bibliothèque, ce n'est pas le même objet.
			     Cadres VIDES : aucune photo à cette étape. -->
			<GalleryRibbon01
				id="gallery"
				eyebrow="Gallery"
				title="A few moments from an ordinary week"
				thumbWidth={325}
				thumbHeight={350}
				radius={32}
				speed={60}
				startOffset={10}
				regionLabel="Gallery — scrollable with the arrow keys"
				items={galerie}
			/>

			<!-- 14 · FAQ -->
			<Faq01
				id="faq"
				eyebrow="FAQ"
				title="The questions owners ask us before their first visit"
				openFirst={true}
				{/* PAS de bouton ici : la référence n'en a qu'UN à cet endroit,
				    et c'est celui posé DANS la pastille orange juste en
				    dessous. Deux boutons à 150 px l'un de l'autre, c'est deux
				    fois la même action. */}
				cta={null}
				media={null}
				items={[
					{ question: "How often should my animal see a vet?", answer: "Once a year for a healthy adult. Puppies, kittens and older animals need more frequent visits, and we will tell you when." },
					{ question: "Do you handle emergencies at night?", answer: "Yes. A vet is on call around the clock. Call the practice number and you will reach someone, not a machine." },
					{ question: "Can I book online?", answer: "Yes, through the form on this page. We confirm your slot within the same working day." },
					{ question: "Which vaccines does my animal need?", answer: "It depends on age, species, and contact with other animals. We go through it at the first visit." },
					{ question: "How do I know if my animal needs dental care?", answer: "Bad breath, difficulty eating, or visible tartar. We check the teeth at every routine examination." },
					{ question: "Do you offer grooming as a separate visit?", answer: "Yes. Grooming is booked on its own, with its own slot, never squeezed between consultations." },
				]}
				schema={false}
			/>

			<!-- 15 · Bandeau urgences — REFAIT le 21/09 (FORMAT.md §14).
			     C'était une section sombre pleine largeur, avec titre, paragraphe,
			     bouton et photo de chat. La référence n'a rien de tout ça : une
			     pastille de 650 × 85, rayon 20, centrée, UNE phrase, pas d'image.
			     banner-01 ne sait pas faire cet objet — d'où notice-pill-01, local. -->
			<NoticePill01
				text="A vet is on call around the clock, every single day of the year."
				cta={{ label: "Book a visit for us", href: "#book" }}
				width={650}
				height={85}
				radius={20}
				tone="accent"
			/>

			<!-- 16 · Formulaire — champs "service souhaité" et "date souhaitée"
			     ajoutés en C3 (select + input date natifs, sur la copie projet du
			     bloc). Pas de destination configurée : le formulaire n'envoie
			     nulle part. -->
			<Contact01
				id="book"
				media={{ width: 530, height: 625, radius: 30, label: "", text: "", src: `${IMG}/contact.webp`, alt: "A golden retriever looking at the camera, head tilted" }}
				tone="ink"
				fieldVariant="bare"
				intro=""
				eyebrow="Contact"
				title="Book a visit"
				quote="Incredible care, and a service that treats you like a person. We moved across the city and still come back."
				quoteAuthor="Amina R. — two cats and a rabbit"
				action=""
				submitLabel="Send my request"
				nameLabel="Full name"
				phoneLabel="Phone"
				emailLabel="Email"
				messageLabel="Your request"
				serviceLabel="Preferred service"
				serviceEmptyOption="Select a service"
				serviceOptions={[
					"Health checks & vaccination",
					"Grooming",
					"Dental care",
					"Surgery & hospitalisation",
					"Nutrition advice",
					"Emergencies",
				]}
				dateLabel="Preferred date"
				showDateField={true}
				timeLabel="Preferred time"
				showTimeField={true}
